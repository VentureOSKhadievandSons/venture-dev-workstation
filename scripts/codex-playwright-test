#!/usr/bin/env bash
set -Eeuo pipefail

WORKSPACE_DIR="${CODEX_BROWSER_QA_DIR:-$HOME/.codex-tools/browser-qa}"

if [[ ! -d "$WORKSPACE_DIR" ]]; then
  echo "Playwright workspace not found at $WORKSPACE_DIR"
  echo "Run ./install/playwright.sh first."
  exit 1
fi

cd "$WORKSPACE_DIR"
exec pnpm exec playwright test "$@"
