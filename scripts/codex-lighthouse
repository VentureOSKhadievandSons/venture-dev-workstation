#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: codex-lighthouse https://example.com [output-prefix]"
  exit 1
fi

URL="$1"
OUTPUT="${2:-lighthouse-report}"

exec lighthouse "$URL" \
  --output=html \
  --output=json \
  --output-path="$OUTPUT" \
  --chrome-flags="--headless --no-sandbox"
