#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/scripts/lib/common.sh"

if command_exists gitleaks; then
	exec gitleaks detect --no-git --source "$ROOT_DIR" --redact --verbose
fi

if contains_secret_like_content "$ROOT_DIR"; then
	die "Secret-like content detected by fallback regex scan."
fi

log "No secret-like content detected by fallback regex scan."
